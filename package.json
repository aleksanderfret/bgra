{
  "name": "bga",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first voice assistant that teaches board game rules from your own rulebooks",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write && pnpm --filter rag-engine format",
    "verify": "turbo run typecheck test lint build && biome check",
    "preflight": "turbo run lint typecheck test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
