# Copy this file to `.env` in this same directory and edit it. That is the
# one place the engine and `scripts/pull-models.sh` read. A shell export of
# the same name still wins, if you need a one-off override.

# Which model set to load: starter-32gb (M1/M2 Pro, 32 GB) or full-64gb (64 GB).
# Definitions: rag_engine/settings.py — do not put model tags in here.
BGA_MODEL_PROFILE=starter-32gb

# Where Ollama listens. Nothing in this project calls a remote API.
BGA_OLLAMA_URL=http://127.0.0.1:11434

# How many chunks to retrieve before reranking, and how many survive it.
BGA_RETRIEVAL_CANDIDATES=40
BGA_RETRIEVAL_TOP_K=6

# Below this rerank score the engine answers "not covered by the rules" instead
# of guessing. Tune it with the evaluation set from stage 6, not by feel.
BGA_MIN_RELEVANCE_SCORE=0.35
